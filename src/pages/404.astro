---
import Base from '../layouts/Base.astro';
---

<Base title="404 · Siddhant Thakur" description="This page does not exist.">
  <main id="main" class="wrap nf">
    <p class="mono code">404 · not found</p>
    <h1>Nothing lives at this address.</h1>
    <p><a href="/">Go to the home page</a></p>
  </main>
</Base>

<style>
  .nf {
    min-height: 80vh;
    display: grid;
    align-content: center;
    gap: 1.2rem;
  }
  .code {
    color: var(--sodium);
  }
  h1 {
    font-size: var(--step-3);
  }
</style>
