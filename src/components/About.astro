---
import { Picture } from 'astro:assets';
import SectionHead from './SectionHead.astro';
import portrait from '../assets/siddhant.jpg';
import { education, certificates } from '../data/credentials';
import { trajectory } from '../data/trajectory';
---

<section class="wrap about" id="about" aria-labelledby="about-title">
  <SectionHead id="about" kicker="About" title="Late to code, early to systems." />
  <div class="grid">
    <Picture
      src={portrait}
      formats={['avif', 'webp']}
      widths={[360, 540, 720, 1080]}
      sizes="(max-width: 760px) min(80vw, 340px), 340px"
      quality={85}
      alt="Siddhant Thakur, seated, in a dark jacket under warm light"
      class="photo"
      loading="lazy"
    />
    <div class="text">
      <p class="first">
        I didn’t grow up writing code. I studied physics, chemistry, maths and biology in school,
        chose computer science for my degree, then took a year to prepare for the MCA entrance and
        finished my MCA in 2025.
      </p>
      <p>
        What stayed with me is how I think about software. When I get an idea, I don’t picture
        the screens first. I picture the system underneath: the data, the requests arriving
        together, the cost of each one, and what the user sees when something fails. Then I build
        the interface on top, and I care about getting that right too.
      </p>
      <p>
        I use AI tools every day, Claude Code and Codex among them. I treat them like a fast
        team that still needs a lead: I make the decisions, I review the work, and I check it
        against evidence before it ships.
      </p>
    </div>
  </div>

  <div class="path">
    <h3 class="mono">How I got here</h3>
    <ol class="line">
      {trajectory.map((m) => (
        <li>
          <span class="m-when mono">{m.when}</span>
          <span class="m-what">{m.what}</span>
          <span class="m-note">{m.note}</span>
        </li>
      ))}
    </ol>
  </div>

  <div class="records">
    <div>
      <h3 class="mono">Education</h3>
      <ul class="list">
        {education.map((e) => (
          <li>
            <span class="what">{e.degree}</span>
            <span class="sub mono">{e.school} · {e.years}</span>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <h3 class="mono">Certificates</h3>
      <ul class="list">
        {certificates.map((c) => (
          <li>
            <span class="what">{c.name}</span>
            <span class="sub mono">
              {c.issuer} · {c.date}{c.detail && <> · {c.detail}</>}
            </span>
            <a class="proof mono" href={c.href} rel="noopener">
              {c.linkLabel}<span class="visually-hidden"> {c.name}</span> ↗
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .about {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }
  .grid {
    display: grid;
    grid-template-columns: 340px minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .grid :global(.photo) {
    width: 100%;
    /* Same 3:4 shape as the photo itself, so nothing is cropped:
       the original has only a little space above the hair. */
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: 50% 0%;
    border-radius: var(--radius);
    filter: saturate(0.92);
  }
  /* Linear-style hover: a small lift, plus an amber edge from the page's accent.
     Only on devices that can hover; reduced motion removes the fade. */
  @media (any-hover: hover) {
    .grid :global(.photo) {
      transition: filter 0.25s ease, box-shadow 0.25s ease;
    }
    .grid :global(.photo:hover) {
      filter: saturate(1) brightness(1.06);
      box-shadow: 0 0 0 1px var(--sodium);
    }
  }
  .text {
    display: grid;
    gap: 1.1rem;
    max-width: var(--measure);
    color: var(--paper-dim);
  }
  .first {
    color: var(--paper);
    font-size: var(--step-1);
    line-height: 1.45;
  }

  .path {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding-top: 1.6rem;
    border-top: 1px dashed var(--line);
  }
  .line {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.6rem 1.4rem;
  }
  .line li {
    position: relative;
    display: grid;
    gap: 0.25rem;
    align-content: start;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .line li::before {
    content: '';
    position: absolute;
    top: -4px;
    left: 0;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--muted);
  }
  .line li:last-child::before {
    background: var(--ok);
  }
  .m-when {
    color: var(--sodium);
    font-size: 0.74rem;
  }
  .m-what {
    color: var(--paper);
    line-height: 1.3;
  }
  .m-note {
    color: var(--paper-dim);
    font-size: 0.92rem;
    line-height: 1.45;
  }
  @media (max-width: 980px) {
    .line {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 520px) {
    .line {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.1rem;
    }
  }

  .records {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.6fr);
    gap: clamp(2rem, 5vw, 4rem);
    margin-top: clamp(2.2rem, 4vw, 3rem);
    padding-top: 1.6rem;
    border-top: 1px dashed var(--line);
  }
  .path h3,
  .records h3 {
    color: var(--muted);
    font-size: 0.74rem;
    margin-bottom: 0.9rem;
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.95rem;
  }
  .list li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: 1rem;
    row-gap: 0.15rem;
    align-items: baseline;
  }
  .list .what {
    grid-column: 1;
    color: var(--paper);
    line-height: 1.35;
  }
  .list .sub {
    grid-column: 1;
    color: var(--muted);
    font-size: 0.74rem;
  }
  .list .proof {
    grid-column: 2;
    grid-row: 1;
    white-space: nowrap;
    font-size: 0.76rem;
  }

  @media (max-width: 760px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .grid :global(.photo) {
      width: min(80vw, 340px);
    }
    .records {
      grid-template-columns: 1fr;
    }
  }
</style>
