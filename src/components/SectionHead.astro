---
interface Props {
  id: string;
  kicker: string;
  title: string;
  intro?: string;
}
const { id, kicker, title, intro } = Astro.props;
---

<header class="head">
  <p class="kicker mono">{kicker}</p>
  <h2 id={`${id}-title`}>{title}</h2>
  {intro && <p class="intro">{intro}</p>}
</header>

<style>
  .head {
    display: grid;
    grid-template-columns: minmax(10rem, 0.32fr) 1fr;
    column-gap: 2rem;
    row-gap: 0.9rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--line);
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }
  .kicker {
    color: var(--sodium);
    padding-top: 0.55rem;
  }
  h2 {
    font-size: var(--step-2);
    letter-spacing: -0.01em;
  }
  .intro {
    grid-column: 2;
    max-width: var(--measure);
    color: var(--paper-dim);
  }
  @media (max-width: 720px) {
    .head {
      grid-template-columns: 1fr;
    }
    .intro {
      grid-column: 1;
    }
    .kicker {
      padding-top: 0;
    }
  }
</style>
